# Docker Production Environment Configuration
# This file is used specifically for Docker containers

# Database Configuration (Docker internal networking)
DATABASE_URL=postgresql://reasoning_user:reasoning_pass@host.docker.internal:5432/reasoning_db

# OpenAI Configuration (Direct API - no proxy)
OPENAI_API_KEY=your_openai_api_key_here

# OPENAI_BASE_URL is intentionally left empty to use direct OpenAI API
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-luna
DEFAULT_LLM_PROVIDER=openai

# TypeSafe Jev extractor
TYPESAFE_API_KEY=your_typesafe_api_key_here
VARIABLE_EXTRACTOR=auto
JEV_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.55
JEV_NUMBER_CONFIDENCE_THRESHOLD=0.25
JEV_GUARDS_ENABLED=true
JEV_BLOCK_OUT_OF_SCOPE=false
JEV_SCOPE_THRESHOLD=0.3
# Hybrid: GPT fills mandatory facts Jev is less than this sure of (empty disables), and confirms a VALID
# when any fact behind it is below HYBRID_CHECK_BELOW. See bench/RESULTS.md.
HYBRID_ESCALATE_BELOW=0.6
HYBRID_CONFIRM_APPROVALS=true
HYBRID_CHECK_BELOW=0.95
HYBRID_FAIL_CLOSED=true
JEV_INJECTION_HOLDS_APPROVAL=true
# gpt-6-luna reasoning effort: none|low|medium|high|xhigh. Extraction has its own knob.
OPENAI_REASONING_EFFORT=low
EXTRACTION_REASONING_EFFORT=none

# Anthropic Configuration (if needed)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO

# Security Settings
APP_NAME=Anchor 