# Environment Configuration Template
# Copy this file to .env and fill in your values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

# TypeSafe Jev extractor (facts). Leave blank to use the LLM extractor in auto mode.
TYPESAFE_API_KEY=your_typesafe_api_key_here
VARIABLE_EXTRACTOR=auto
JEV_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.55
JEV_NUMBER_CONFIDENCE_THRESHOLD=0.25
JEV_GUARDS_ENABLED=true
JEV_BLOCK_OUT_OF_SCOPE=false
JEV_SCOPE_THRESHOLD=0.3
# Hybrid: GPT fills mandatory facts Jev is less than this sure of (empty disables), and confirms a VALID
# when any fact behind it is below HYBRID_CHECK_BELOW. See bench/RESULTS.md.
HYBRID_ESCALATE_BELOW=0.6
HYBRID_CONFIRM_APPROVALS=true
HYBRID_CHECK_BELOW=0.95
HYBRID_FAIL_CLOSED=true
JEV_INJECTION_HOLDS_APPROVAL=true
# gpt-6-luna reasoning effort: none|low|medium|high|xhigh. Extraction has its own knob.
OPENAI_REASONING_EFFORT=low
EXTRACTION_REASONING_EFFORT=none

# Database Configuration
DATABASE_URL=postgresql://reasoning_user:reasoning_pass@localhost:5432/reasoning_db

# Alternative LLM Provider (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Configuration
DEBUG=false
LOG_LEVEL=info

# MCP Server Configuration
# The MCP server runs independently and uses the same database and API keys
# No additional configuration needed - uses existing settings above

# Docker Environment Template
# For Docker deployment, copy this to .env.docker
# OPENAI_API_KEY=your_openai_api_key_here